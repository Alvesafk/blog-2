---
import Public from '../layouts/Public.astro';

import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	title: string;
	createdAt: Date;
}

const { title, createdAt } = Astro.props;
---

<Public pageTitle={title}>
	<div>
		<a href="/">Home</a>
		<h2>{title}</h2>
	</div>
	<slot/>
	<div>Posted at <FormattedDate date={createdAt} /></div>
</Public>
