---
import { Font } from 'astro:assets';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{title}</title>
	<Font cssVariable="--font-libron" preload />
	<Font cssVariable="--font-advercase" preload />
</head>
