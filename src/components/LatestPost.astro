---
import { getCollection, type CollectionEntry } from "astro:content";

type Post = CollectionEntry<'posts'>;

function getLatestPostTags(post: Post): string {
	if (post.data.tags.length < 1) {
		return ""
	}

	let result = "";

	for (let tag of post.data.tags) {
		result += tag + ", "
	}

	return result.slice(0, result.length - 2)
}

const latestPost = (await getCollection("posts")).sort(
	(a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf(),
)[0];
---

<div>
	<h2 class="text-2xl">This is my latest post</h2>
	<div>
		<header>
			<a href={"/post/" + latestPost.id}>
				<h3 class="underline">{latestPost.data.title}</h3>
			</a>
		</header>
		<div class="text-md">
			<a href={"/post/" + latestPost.id}>
				<p>{latestPost.data.description}</p>
				<div class="flex justify-between">
					<div>
						<small class="text-sm">{getLatestPostTags(latestPost)}</small>
					</div>
					<div>
						<small class="text-sm">Read it in {latestPost.data.readTime} minutes</small>
					</div>
				</div>
			</a>
		</div>
	</div>
</div>
