---
import { getCollection } from "astro:content";

const latestPost = (await getCollection("posts")).sort(
	(a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf(),
)[0];
---

<div>
	<h2 class="text-2xl">This is my latest post</h2>
	<div>
		<header>
			<a href={"/post/" + latestPost.id}>
				<h3 class="underline">{latestPost.data.title}</h3>
			</a>
		</header>
		<div class="text-md">
			<a href={"/post/" + latestPost.id}>
				<p>{latestPost.data.description}</p>
				<p>{latestPost.data.tags.map((tag) => (
					<small class="text-sm">
						{tag + " "}
					</small>
					))}
				</p>
			</a>
		</div>
	</div>
</div>
