---
import Public from '../layouts/Public.astro';
import { Image } from 'astro:assets';
import homeImage from '../assets/img/home.jpeg';
import LatestPost from '../components/LatestPost.astro';
import Link from '../components/Link.astro';
---

<Public pageTitle="Home Page">
	<div class="flex justify-between w-5xl mx-auto text-xl">
		<article class="w-xl mr-8">
			<LatestPost/>

			<div class="my-4">
				<h2 class="text-2xl">Links</h2>
				<ul>
					<li><Link path="https://github.com/Alvesafk" target='_blank'>Github</Link></li>
					<li><Link path="mailto:migueldealmeidaalves55@gmail.com">Email</Link></li>
					<li>Curriculum</li>
				</ul>
			</div>

			<div class="mb-4">
				<h2 class="text-2xl">Tech used here</h2>
				<p>
					<Link path="https://astro.build" target="_blank">Astro</Link>, <Link path="https://tailwindcss.com" target="_blank">Tailwind</Link>,
					<Link path="https://www.typescriptlang.org/" target="_blank"> Typescript</Link>, <Link path="https://viteplus.dev/" target="_blank">Vite+</Link>,
					this type of stoff
				</p>
			</div>
		</article>
		<section>
			<Image src={homeImage} alt="Super cool image of the Schrodinger Cat" width="540" height="740"/>
		</section>
	</div>
</Public>
